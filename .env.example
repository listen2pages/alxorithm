# ==============================================================================
# Alxorithm Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your credentials.
# ==============================================================================

# Public Site Origin (used for OAuth callbacks, Stripe redirects, and metadata)
NEXT_PUBLIC_SITE_URL=https://alxorithm.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for server-side Stripe webhook synchronization with public.subscriptions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI (used for semantic column mapping and executive insights)
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Stripe Billing & Subscription Sync
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Optional: set STRIPE_PRICE_ID to create dynamic Checkout Sessions (with 7-day trial)
STRIPE_PRICE_ID=price_your_monthly_400_pln_price_id
# Optional override for fallback Stripe Payment Link or hosted Customer Portal URL
STRIPE_PAYMENT_LINK=https://buy.stripe.com/28E9ASacmewvaWQ0843Je04
STRIPE_CUSTOMER_PORTAL_URL=
